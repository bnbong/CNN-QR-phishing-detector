backups/data/

# 예시 이미지
*.png
*.jpg
*.jpeg

# 모델 평가 지표 이미지 파일 예외처리
!backups/evaluate_outputs/*.png
!backups/evaluate_outputs/*.jpg
!backups/evaluate_outputs/*.jpeg

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover

# Translations
*.mo
*.pot

# Django stuff:
*.log
*.csv

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Emacs
.#*

# Notebook Checkpoints
.ipynb_checkpoints/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# 데이터셋
data/

# macOS
.DS_Store
._.DS_Store
**/.DS_Store

# AI output
*.h5
*.keras
*.keras-v3.10
*.keras-v3.11
*.keras-v3.12
*.keras-v3.13
*.keras-v3.14
*.keras-v3.15

# uv / 가상환경
.venv/

# 실험 산출물
artifacts/
*.npz

# 데이터 (backups/data 규칙은 위에 유지)
data/*.csv
data/*.xlsx

# 리포트 산출물은 커밋한다 (위 *.csv / *.png 규칙 예외)
!reports/*.csv
!reports/*.png

# 외부 수집 원본·중간 산출물은 커밋하지 않는다 (약관·용량). 메타는 reports/external/에 커밋.
data/external/
